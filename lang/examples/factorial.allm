# Factorial computation in ALLM
# Demonstrates: functions, loops, arithmetic

fn factorial(n: i32) -> i32
    let mut result: i32 = 1
    let mut i: i32 = 1
    while i <= n
        result = result * i
        i = i + 1
    end
    return result
end

fn main() -> i32
    let x: i32 = factorial(5)
    # x should be 120
    return x
end
