# Expression structure
struct Expr
    kind: i32
    line: i32
    col: i32
    int_value: i64
    str_value: *i8
    str_len: i32
    bool_value: bool
    op: i32
    left: *Expr
    right: *Expr
    unary_op: i32
    operand: *Expr
    args: *ExprList
    object: *Expr
    field: *i8
    field_len: i32
    struct_name: *i8
    struct_name_len: i32
    struct_fields: *FieldInitList
    index_obj: *Expr
    index: *Expr
    cast_type: *Type
end

struct ExprList
    expr: *Expr
    next: *ExprList
end

struct FieldInit
    name: *i8
    name_len: i32
    value: *Expr
end

struct FieldInitList
    field: *FieldInit
    next: *FieldInitList
end

# Expression construction functions (extern from ast.allm)
