# Token structure (from lexer)
struct Token
    type: i32
    value: *i8
    len: i32
    line: i32
    col: i32
end

# Token array for parser
struct TokenArray
    tokens: *Token
    count: i32
    capacity: i32
end

fn token_array_new() -> *TokenArray
    let arr: *TokenArray = malloc(32) as *TokenArray
    (^arr).tokens = malloc(1024) as *Token
    (^arr).count = 0
    (^arr).capacity = 64
    return arr
end

fn token_array_push(arr: *TokenArray, tok: Token) -> void
    if (^arr).count >= (^arr).capacity
        let new_cap: i32 = (^arr).capacity * 2
        let new_tokens: *Token = malloc(new_cap * 40) as *Token
        let i: i32 = 0
        while i < (^arr).count
            let old_ptr: *Token = (^arr).tokens + i
            let new_ptr: *Token = new_tokens + i
            (^new_ptr).type = (^old_ptr).type
            (^new_ptr).value = (^old_ptr).value
            (^new_ptr).len = (^old_ptr).len
            (^new_ptr).line = (^old_ptr).line
            (^new_ptr).col = (^old_ptr).col
            i = i + 1
        end
        free((^arr).tokens as *i8)
        (^arr).tokens = new_tokens
        (^arr).capacity = new_cap
    end
    let ptr: *Token = (^arr).tokens + (^arr).count
    (^ptr).type = tok.type
    (^ptr).value = tok.value
    (^ptr).len = tok.len
    (^ptr).line = tok.line
    (^ptr).col = tok.col
    (^arr).count = (^arr).count + 1
end

fn token_array_get(arr: *TokenArray, index: i32) -> *Token
    let ptr: *Token = (^arr).tokens + index
    return ptr
end

