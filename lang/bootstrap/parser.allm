# Type structure
struct Type
    kind: i32
    name: *i8
    name_len: i32
    inner: *Type
    element: *Type
    size: i32
end

# Type construction functions (extern from ast.allm)
extern fn type_new(kind: i32) -> *Type
extern fn type_new_ptr(inner: *Type) -> *Type
extern fn type_new_named(name: *i8, len: i32) -> *Type
extern fn type_new_array(element: *Type, size: i32) -> *Type

# ============================================================
# Parser state
# ============================================================
struct Parser
    tokens: *TokenArray
    pos: i32
end

fn parser_new(tokens: *TokenArray) -> *Parser
    let p: *Parser = malloc(32) as *Parser
    (^p).tokens = tokens
    (^p).pos = 0
    return p
end

fn parser_peek(p: *Parser) -> *Token
    let arr: *TokenArray = (^p).tokens
    return token_array_get(arr, (^p).pos)
end

fn parser_previous(p: *Parser) -> *Token
    let arr: *TokenArray = (^p).tokens
    return token_array_get(arr, (^p).pos - 1)
end

fn parser_is_at_end(p: *Parser) -> bool
    let tok: *Token = parser_peek(p)
    return (^tok).type == TOK_EOF()
end

fn parser_advance(p: *Parser) -> *Token
    if not parser_is_at_end(p)
        (^p).pos = (^p).pos + 1
    end
    return parser_previous(p)
end

fn parser_check(p: *Parser, type: i32) -> bool
    if parser_is_at_end(p)
        return false
    end
    let tok: *Token = parser_peek(p)
    return (^tok).type == type
end

fn parser_match(p: *Parser, type: i32) -> bool
    if parser_check(p, type)
        parser_advance(p)
        return true
    end
    return false
end

fn parser_error(p: *Parser, msg: *i8) -> void
    let tok: *Token = parser_peek(p)
    puts("Parse error at line ")
    puts(msg)
    exit(1)
end

fn parser_expect(p: *Parser, type: i32, msg: *i8) -> *Token
    if parser_check(p, type)
        return parser_advance(p)
    end
    parser_error(p, msg)
    return null
end

